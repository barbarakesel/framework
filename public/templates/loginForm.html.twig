<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title></title>
</head>
<body>
<div style='background: lightpink; color: white; padding: 20px;  height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; '>
    <form method='POST' action='/login'>
        <div style="padding-bottom: 16px">

            <label>
                <input name='email' style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px; background: white'>
            </label>
        </div>
        <div style="padding-bottom: 16px">
            <label>
                <input type="password" name='password' style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px; background: white'>
            </label>
        </div>
        <button type='submit' style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px; background: white'>Login</button>
    </form>
</div>
</body>
</html>