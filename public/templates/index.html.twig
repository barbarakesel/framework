<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
<body>
<header class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-between py-3 border-bottom px-5 mx-5">

    <div class="text-end d-flex flex-row">
        <h1 class="pe-5">{% if lang == 'en' %} Audience Analyzer {% elseif lang == 'ru' %} Анализ Аудитории {% endif %}</h1>
        <ul class="nav col-12 col-lg-auto me-lg-auto mb-2 mb-md-0">
        <li><a class="nav-link px-2 link-body-emphasis py-3" href='/file' data-bs-toggle="modal" data-bs-target="#uploadFile">{% if lang == 'en' %} Upload File {% elseif lang == 'ru' %} Загрузить файл {% endif %}</a></li>
        <li><a class="nav-link px-2 link-body-emphasis py-3" href = '/generate-form' data-bs-toggle="modal" data-bs-target="#generateData">{% if lang == 'en' %} Generate Data {% elseif lang == 'ru' %} Сгенерировать данные {% endif %}</a></li>
        </ul>
    </div>

    <div class="col-md-3 text-end">
        {% if user_id %}
            <a href="/logout">
                <button type="button" class="btn btn-outline-danger">{% if lang == 'en' %} Logout {% elseif lang == 'ru' %} Выйти {% endif %}</button>
            </a>
        {% else %}
            <a><button type="button" class="btn btn-outline-primary me-2" data-bs-toggle="modal" data-bs-target="#login">{% if lang == 'en' %} Login {% elseif lang == 'ru' %} Войти {% endif %}</button></a>
            <a><button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#register">{% if lang == 'en' %} Sign-up {% elseif lang == 'ru' %} Зарегистрироваться {% endif %}</button></a>
        {% endif %}

        <span class="ms-3">
             <a href = '/set-language?lang=ru'><button class="btn btn-outline">ru</button></a>
            /
             <a href = '/set-language?lang=en'><button class="btn btn-outline">en</button></a>
        </span>
    </div>
</header>
<main>
    <div class="container">
        <!-- Модальное окно upload files -->
        <div class="modal fade" id="uploadFile" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel">{% if lang == 'en' %} Upload File {% elseif lang == 'ru' %} Загрузить файл {% endif %}</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <div class="lead text-body-secondary text-center">{% if lang == 'en' %} Enter company ID  {% elseif lang == 'ru' %} Введите ID компании {% endif %}</div>
                        <form action='/upload' method='post' enctype='multipart/form-data'>
                            <div class="d-flex flex-column">
                                <div class="text-center p-3">
                                    <select id="organizationSelect" name="organization_id" class="btn btn-secondary dropdown-toggle" style="width:150px; font-size: 20px">
                                        {% for item in names %}
                                            <option value="{{ item.id }}">{{ item.name }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="p-3 text-center"><input type='file' name='csv' value='' /></div>
                                <div class="text-center"><input type='submit' name='submit' class="btn btn-primary m-5" style = "width: 250px; height: 50px; border-radius: 12px; font-size: 20px;" value='{% if lang == 'en' %} Upload {% elseif lang == 'ru' %} Загрузить {% endif %}' /></div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно generate files -->
        <div class="modal fade" id="generateData" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel">{% if lang == 'en' %} Generate Data {% elseif lang == 'ru' %} Сгенерировать данные {% endif %}</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <div class="lead text-body-secondary text-center">{% if lang == 'en' %} Enter number and choose Organization {% elseif lang == 'ru' %} Введите число и выберите организацию {% endif %}</div>
                        <form method='POST' action='/generate'>
                            <div class="d-flex flex-column">
                               <div class="text-center p-3">
                                   <select id="organizationSelect" name="organization_id" class="btn btn-secondary dropdown-toggle" style="width:150px; font-size: 20px">
                                       {% for item in names %}
                                           <option value="{{ item.id }}">{{ item.name }}</option>
                                       {% endfor %}
                                   </select>
                               </div>
                               <!-- Сделать выпадающий список с названиями компаний точбы выбирать для какой компании генерировать записи
                                    РЕАЛИЗОВАТЬ ЛОГИКУ ЧТО РНАЗВАНИЯ КОМПАНИЙ ПЕРЕДАЮТСЯ В КОНТРОЛЛЕР GENERATE
                               -->

                            <div class="text-center"><input type='number' name='quantity' min='1' max='100' style = 'width: 250px; font-size: 20px; border-radius: 12px; background: white' value='quantityForm'></div>
                            <div class="text-center p-3"><button type='submit' class="btn btn-primary"  style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px;'>{% if lang == 'en' %} Generate {% elseif lang == 'ru' %} Сгенерировать {% endif %}</button></div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно register -->
        <div class="modal fade" id="register" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel">Register</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <div id="registerError" class="alert alert-danger text-center d-none"></div>

                        <form id="registerForm" method="POST">
                        <div class="d-flex flex-column">
                            <div class="form-floating text-center">
                                <input name='email' style = 'width: 250px; font-size: 20px; border-radius: 12px; background: white'>
                            </div>
                            <div class="form-floating text-center py-3">
                                <input type="password" name='password'  style = 'width: 250px;  font-size: 20px; border-radius: 12px; background: white'>
                            </div>
                            <div class="text-center"><button type='submit' class="btn btn-primary mt-3" style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px;'>Register</button></div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно login -->
        <div class="modal fade" id="login" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="staticBackdropLabel">Login</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <form method='POST' action='/login'>
                            <div class="d-flex flex-column">
                                <div class="form-floating text-center">
                                    <input name='email' style = 'width: 250px; font-size: 20px; border-radius: 12px; background: white'>
                                </div>
                                <div class="form-floating text-center py-3">
                                    <input type="password" name='password' style = 'width: 250px;  font-size: 20px; border-radius: 12px; background: white'>
                                </div>
                                <div class="text-center"><button type='submit' class="btn btn-primary mt-3" style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px;'>Login</button></div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="px-5 pt-5 mb-4 bg-body-tertiary rounded-3">
        <div class="row align-items-md-stretch">
            <div class="col-md-6">
                <div class="h-100 p-5 text-bg-dark border rounded-3 d-flex flex-row justify-content-between">
                    <div>
                        <h2 class="pb-3">{% if lang == 'en' %} Filter Data {% elseif lang == 'ru' %} Все данные {% endif %}</h2>
                        <a href = '/filter'><button class="btn btn-outline-primary" style="width: 150px; font-size: 20px" type="button">{% if lang == 'en' %} Filter {% elseif lang == 'ru' %} Фильтровать {% endif %}</button></a>
                    </div>
                    <div class="px-5">
                        <img src="https://www.svgrepo.com/show/179296/filter-tool.svg" style="max-height: 100px" alt="">
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                    <div class="h-100 p-5 bg-body-tertiary border rounded-3 d-flex flex-row justify-content-between">
                        <div>
                            <h2 class="pb-3">{% if lang == 'en' %} Statistics {% elseif lang == 'ru' %} Статистика {% endif %}</h2>
                            <a href = '/stat'><button class="btn btn-outline-primary" style="width: 150px; font-size: 20px" type="button">{% if lang == 'en' %} Calculate {% elseif lang == 'ru' %} Посчитать {% endif %}</button></a>
                        </div>
                        <div class="px-5">
                            <img src="https://www.svgrepo.com/show/21279/stats.svg" style="max-height: 100px" alt="">
                        </div>
                </div>
            </div>
        </div>
  </div>
        <div class="p-5 mb-4 bg-body-tertiary rounded-3">
            <div class="container-fluid">
                <h2 class="display-5 fw-bold">{% if lang == 'en' %} Organizations {% elseif lang == 'ru' %} Организации {% endif %}</h2>
                <div class="mb-3"><img src="https://on24.media/wp-content/uploads/2023/02/nko42602.jpg" style=" max-height:150px; width:100%; object-fit: cover; object-position: center;"></div>
                <a href = '/organization'><button class="btn btn-primary btn-lg" type="button">{% if lang == 'en' %} Organizations {% elseif lang == 'ru' %} Организации {% endif %}</button></a>
            </div>
        </div>
    </div>

    <!-- Модальное окно успешной загрузки -->
    <div id="importModal" style="display:none; position:fixed; top:20%; left:50%; transform:translate(-50%, 0); background:white; padding:20px; border:1px solid #ccc; z-index:1000;">
          <div class="modal-dialog">
            <div class="modal-content" style = "border: 0;">
                    <div class="lead text-body-secondary text-center">{% if lang == 'en' %} Data loaded successfully! {% elseif lang == 'ru' %} Данные успешно загружены! {% endif %}</div>
                    <button class="btn btn-primary mt-3" style = 'width: 100%; height: 50px; font-size: 20px; border-radius: 12px;' onclick="document.getElementById('importModal').style.display='none'">ОК</button>
            </div>
        </div>
    </div>

    <!-- Модальное окно успешной генерации -->
    <div id="generateModal" style="display:none; position:fixed; top:20%; left:50%; transform:translate(-50%, 0); background:white; padding:20px; border:1px solid #ccc; z-index:1000;">
        <div class="modal-dialog">
            <div class="modal-content" style = "border: 0;">
                <div class="lead text-body-secondary text-center">{% if lang == 'en' %} Data generated successfully! {% elseif lang == 'ru' %} Данные успешно сгенерированы! {% endif %}</div>
                <button class="btn btn-primary mt-3" style = 'width: 100%; height: 50px; font-size: 20px; border-radius: 12px;' onclick="document.getElementById('generateModal').style.display='none'">ОК</button>
            </div>
        </div>
    </div>


</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    const params = new URLSearchParams(window.location.search);
    if (params.get('import') === 'success') {
        document.getElementById('importModal').style.display = 'block';
    } else if (params.get('generate') === 'success') {
        document.getElementById('generateModal').style.display = 'block';
    }

    window.history.replaceState({}, document.title, window.location.pathname);
</script>
<script>
    $(document).ready(function () {
        $('#registerForm').submit(function (e) {
            e.preventDefault();

            $.ajax({
                url: '/register',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    console.log("SUCCESS:", response);
                    if (response.success) {
                        $('#register').modal('hide');
                        $('#registerForm')[0].reset();
                        $('#registerError').addClass('d-none').text('');
                    } else {
                        $('#registerError').removeClass('d-none').text(response.message);
                    }
                },
                error: function (xhr, status, error) {
                    console.log("ERROR:", xhr.responseText);
                    $('#registerError').removeClass('d-none').text('Ошибка при соединении с сервером');
            }
            });
        });
    });
</script>

</body>
</html>