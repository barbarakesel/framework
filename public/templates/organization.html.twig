<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
<body>
<div class="container">
    <div style='display:flex; justify-content:center; flex-direction:column; '>
        <a href="/" style="padding: 20px;">
            To Main Page
        </a>
    </div>
    <h1>Organizations</h1>
    <div style='display:flex; justify-content:center; flex-direction:column; '>
        <table style="border: 1px solid black; border-collapse: collapse; width: 100%; background: #ffffff;">
            <thead>
            <tr style="background-color: blue; color: white">
                <th style="padding: 10px;">ID</th>
                <th style="padding: 10px;">Organization</th>
            </tr>
            </thead>
            <tbody>
            {% for row in results %}
                <tr>
                    {% for value in row %}
                        <td style="padding: 10px; color: black;">{{ value }}</td>
                    {% endfor %}
                </tr>
            {% endfor %}
            </tbody>
        </table></div>
    <div class="row align-items-md-stretch py-5">
        <div class="col-md-4">
            <div class="h-100 p-5 text-bg-dark border rounded-3">
                <h2>Create Organization</h2>
                <a><button class="btn btn-outline-primary" style="font-size: 20px; width: 150px; border-radius: 8px" type="button" data-bs-toggle="modal" data-bs-target="#create">Create</button></a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="h-100 p-5 bg-body-tertiary border rounded-3">
                <h2>Delete organization</h2>
                <a><button class="btn btn-outline-primary" style="font-size: 20px; width: 150px; border-radius: 8px" type="button" data-bs-toggle="modal" data-bs-target="#delete">Delete</button></a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="h-100 p-5 bg-body-tertiary border rounded-3">
                <h2>Change organization</h2>
                <a><button class="btn btn-outline-primary" style="font-size: 20px; width: 150px; border-radius: 8px" type="button" data-bs-toggle="modal" data-bs-target="#change">Change</button></a>
            </div>
        </div>
    </div>

    <!-- Модальное окно create -->
    <div class="modal fade" id="create" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Create Organization</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center" style="font-size: 20px">Enter Organization Name</div>
                    <form method='POST' action='/organization/create'>
                        <div class="d-flex  flex-column">
                            <div class="text-center py-3"><input name='name' style = 'width: 250px; font-size: 20px; border-radius: 12px; background: white'></div>
                            <div class="text-center"><button type='submit' class="btn btn-primary" style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px;'>Create</button></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Модальное окно delete -->
    <div class="modal fade" id="delete" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Delete Organization</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center" style="font-size: 20px">Enter Organization ID</div>
                    <form method='POST' action='/organization/delete' onsubmit="return confirmDelete()">
                        <div class="text-center py-3">
                            <input name='id' style = 'width: 250px; font-size: 20px; border-radius: 12px; background: white'>
                        </div>
                        <div class="text-center">
                            <button type='submit' style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px;' class="btn btn-primary">Delete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Модальное окно change -->
    <div class="modal fade" id="change" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Change Organization</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center" style="font-size: 20px">Enter Organization ID</div>
                    <form method='POST' action='/organization/change'>
                        <div class="d-flex  flex-column">
                            <div class="text-center py-3">
                                <input name='id' style = 'width: 250px; font-size: 20px; border-radius: 12px; background: white'>
                            </div>
                            <div class="text-center"><button type='submit' class="btn btn-primary" style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px;'>Change</button></div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
<script>
    function confirmDelete() {
        return confirm("Are you sure?");
    }
</script>
</body>
</html>