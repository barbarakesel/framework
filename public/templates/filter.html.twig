<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Table</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
<body>
<div class="container">
    <div style="display:flex; justify-content:center; flex-direction:column;">
        <a href="/" style="padding: 20px;">
            To Main Page
        </a>
    </div>

    <table style="border: 1px solid black; border-collapse: collapse; width: 100%; background: #ffffff;">
        <thead>
        <tr style="background-color: blue; color: white">
            <th style="padding: 10px;">ID</th>
            <th style="padding: 10px;">Country</th>
            <th style="padding: 10px;">City</th>
            <th style="padding: 10px;">Is Active</th>
            <th style="padding: 10px;">Gender</th>
            <th style="padding: 10px;">Birth Date</th>
            <th style="padding: 10px;">Salary</th>
            <th style="padding: 10px;">Has Children</th>
            <th style="padding: 10px;">Family Status</th>
            <th style="padding: 10px;">Registration Date</th>
        </tr>
        </thead>
        <tbody>
        {% for row in results %}
            <tr>
                {% for value in row %}
                    <td style="padding: 10px; color: black;">{{ value }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
</body>
</html>
