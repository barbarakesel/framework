<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>Table</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
<body>
<div class="container">
    <div style="display:flex; justify-content:center; flex-direction:column;">
        <a href="/" style="padding: 20px;">
            {% if lang == 'en' %} To Main Page {% elseif lang == 'ru' %} На главную {% endif %}
        </a>
    </div>

    <table style="border: 1px solid black; border-collapse: collapse; width: 100%; background: #ffffff;">
        <thead>
        <tr style="background-color: blue; color: white">
            <th style="padding: 10px;">{% if lang == 'en' %} ID {% elseif lang == 'ru' %} Идентификатор {% endif %}</th>
            <th style="padding: 10px;">{% if lang == 'en' %} Country {% elseif lang == 'ru' %} Страна {% endif %}</th>
            <th style="padding: 10px;">{% if lang == 'en' %} City {% elseif lang == 'ru' %} Город {% endif %}</th>
            <th style="padding: 10px;">{% if lang == 'en' %} Is Active {% elseif lang == 'ru' %} Активен {% endif %}</th>
            <th style="padding: 10px;">{% if lang == 'en' %} Gender {% elseif lang == 'ru' %} Пол {% endif %}</th>
            <th style="padding: 10px;">{% if lang == 'en' %} Birth Date {% elseif lang == 'ru' %} Дата рождения {% endif %}</th>
            <th style="padding: 10px;">{% if lang == 'en' %} Salary {% elseif lang == 'ru' %} Зарплата {% endif %}</th>
            <th style="padding: 10px;">{% if lang == 'en' %} Has Children {% elseif lang == 'ru' %} Дети {% endif %}</th>
            <th style="padding: 10px;">{% if lang == 'en' %} Family Status {% elseif lang == 'ru' %} Статус {% endif %}</th>
            <th style="padding: 10px;">{% if lang == 'en' %} Registration Date {% elseif lang == 'ru' %} Дата регистрации {% endif %}</th>
        </tr>
        </thead>
        <tbody>
        {% for row in results %}
            <tr>
                {% for value in row %}
                    <td style="padding: 10px; color: black;">{{ value }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
</body>
</html>
