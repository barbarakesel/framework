<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
<body>
<section class="py-5 text-center container mt-5" style="background: ghostwhite; border-radius: 16px;">
    <div class="row py-lg-5">
        <div class="col-lg-6 col-md-8 mx-auto">
            <h1 class="fw-light">Upload File</h1>
            <p class="lead text-body-secondary">Enter company ID</p>

            <form action='/upload' method='post' enctype='multipart/form-data'>
                <div class="d-flex flex-column">
                    <div class="text-center"><input style = 'width: 250px;  font-size: 20px; border-radius: 12px; background: white' name='organization_id' value='' /></div>
                    <div class="p-3 text-center"><input type='file' name='csv' value='' /></div>
                </div>
                <input type='submit' name='submit' class="btn btn-primary m-5" style = "width: 250px; height: 50px; border-radius: 12px; font-size: 20px;" value='Upload' />
            </form>

        </div>
    </div>
</section>
</body>
</html>