<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>
<body>
<div class="container d-flex flex-column justify-content-center text-center align-items-center">
    <div class="p-5">
        <p style="font-size: 20px">Change Organization</p>
        {% for item in names %}
            <form method='POST' action='/organization/change/company'>
                <div style="padding-bottom: 16px">
                    <label>
                        <input name='id' value="{{ item.id }}" style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px; background: white' readonly>
                    </label>
                </div>
                <div style="padding-bottom: 16px">
                    <label>
                        <input name="name" value="{{ item.name }}" style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px; background: white'>
                    </label>
                </div>
                <button type='submit' style = 'width: 250px; height: 50px; font-size: 20px; border-radius: 12px;' class="btn btn-primary" >Change</button>
            </form>
        {% endfor %}
    </div>
</div>
</body>
</html>